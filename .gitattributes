# Normalise line endings in the repo to LF (Biome formats with LF too), so
# Windows checkouts don't produce whole-file CRLF diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.onnx binary
*.tar.gz binary

# Generated / vendored — collapsed in diffs, excluded from language stats.
package-lock.json linguist-generated=true
src/web/public/css/tailwind.css linguist-generated=true
