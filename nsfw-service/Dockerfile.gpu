FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY main.py .

ENV TGDL_NSFW_HOST=0.0.0.0
ENV TGDL_NSFW_PORT=8012

EXPOSE 8012

# The model downloads on first start, so give it time before counting failures.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
  CMD python3 -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('TGDL_NSFW_PORT', '8012'), timeout=4)"

CMD ["python3", "main.py"]
