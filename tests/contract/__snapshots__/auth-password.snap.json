{
  "entries": {
    "change-password same as guest → 400": {
      "route": "POST /api/auth/change-password",
      "request": {
        "method": "POST",
        "path": "/api/auth/change-password",
        "as": "admin",
        "body": {
          "currentPassword": "contract-admin-pass",
          "newPassword": "contract-guest-pass"
        }
      },
      "status": 400,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=9, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "code": "SAME_AS_GUEST",
          "error": "New password must differ from the guest password"
        }
      }
    },
    "change-password → 200 + new cookie": {
      "route": "POST /api/auth/change-password",
      "request": {
        "method": "POST",
        "path": "/api/auth/change-password",
        "as": "admin",
        "body": {
          "currentPassword": "contract-admin-pass",
          "newPassword": "changed-admin-pass"
        }
      },
      "status": 200,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=8, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "set-cookie": [
          {
            "name": "tg_dl_session",
            "value": "<session-token>",
            "attributes": {
              "expires": "<time:http>",
              "httponly": true,
              "max-age": "604800",
              "path": "/",
              "samesite": "Strict"
            }
          }
        ],
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "success": true
        }
      }
    },
    "old session keeps working after change": {
      "route": "GET /api/auth_check",
      "request": {
        "method": "GET",
        "path": "/api/auth_check",
        "as": "admin"
      },
      "status": 200,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "authenticated": true,
          "configured": true,
          "enabled": true,
          "guestEnabled": true,
          "role": "admin",
          "setupRequired": false
        }
      }
    },
    "login with the new password": {
      "route": "POST /api/login",
      "request": {
        "method": "POST",
        "path": "/api/login",
        "as": "anon",
        "body": {
          "password": "changed-admin-pass"
        }
      },
      "status": 200,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=7, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "set-cookie": [
          {
            "name": "tg_dl_session",
            "value": "<session-token>",
            "attributes": {
              "expires": "<time:http>",
              "httponly": true,
              "max-age": "604800",
              "path": "/",
              "samesite": "Strict"
            }
          }
        ],
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "role": "admin",
          "success": true
        }
      }
    },
    "login with the old password → 401": {
      "route": "POST /api/login",
      "request": {
        "method": "POST",
