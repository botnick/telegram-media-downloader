    "reset/confirm unknown token → 401": {
      "route": "POST /api/auth/reset/confirm",
      "request": {
        "method": "POST",
        "path": "/api/auth/reset/confirm",
        "as": "anon",
        "body": {
          "newPassword": "reset-admin-pass",
          "token": "ffffffffffffffffffffffffffffffff"
        }
      },
      "status": 401,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=2, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "error": "Invalid or expired token"
        }
      }
    },
