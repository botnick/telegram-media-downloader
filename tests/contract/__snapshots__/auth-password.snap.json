          "error": "Invalid password"
        }
      }
    },
    "reset/request → 200": {
      "route": "POST /api/auth/reset/request",
      "request": {
        "method": "POST",
        "path": "/api/auth/reset/request",
        "as": "anon"
      },
      "status": 200,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=5, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "success": true,
          "ttlSeconds": 600
        }
      }
    },
    "reset token appears on stdout": {
      "note": "the operator copies it from `docker compose logs`; format \"Token: <32 hex>\"",
      "tokenFormat": "32 lowercase hex chars"
    },
    "reset/confirm missing fields → 400": {
      "route": "POST /api/auth/reset/confirm",
      "request": {
        "method": "POST",
        "path": "/api/auth/reset/confirm",
        "as": "anon",
        "body": {
          "token": "<hex32:1>"
        }
      },
      "status": 400,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
