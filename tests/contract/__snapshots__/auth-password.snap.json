        "pragma": "no-cache",
        "ratelimit": "limit=10, remaining=4, reset=<s>",
        "ratelimit-policy": "10;w=900",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "error": "token and newPassword required"
        }
      }
    },
