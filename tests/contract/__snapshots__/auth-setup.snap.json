    "setup from a non-local client → 403": {
      "route": "POST /api/auth/setup",
      "request": {
        "method": "POST",
        "path": "/api/auth/setup",
        "as": "anon",
        "headers": {
          "x-forwarded-for": "203.0.113.9"
        },
        "body": {
          "password": "first-admin-pass"
        }
      },
      "status": 403,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=20, remaining=19, reset=<s>",
        "ratelimit-policy": "20;w=900",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "error": "Initial setup must be done from the local machine. Run `npm run auth` instead."
        }
      }
    },
    "setup → 200 + admin cookie": {
      "route": "POST /api/auth/setup",
      "request": {
        "method": "POST",
        "path": "/api/auth/setup",
        "as": "anon",
        "body": {
          "password": "first-admin-pass"
        }
      },
      "status": 200,
      "headers": {
        "cache-control": "no-store, max-age=0",
        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "ratelimit": "limit=20, remaining=17, reset=<s>",
        "ratelimit-policy": "20;w=900",
        "set-cookie": [
          {
            "name": "tg_dl_session",
            "value": "<session-token>",
            "attributes": {
              "expires": "<time:http>",
              "httponly": true,
              "max-age": "604800",
              "path": "/",
              "samesite": "Strict"
            }
          }
        ],
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "success": true
        }
      }
    },
