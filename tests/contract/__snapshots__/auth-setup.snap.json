        "pragma": "no-cache",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "authenticated": true,
          "configured": true,
          "enabled": true,
          "guestEnabled": false,
          "role": "admin",
          "setupRequired": false
        }
      }
