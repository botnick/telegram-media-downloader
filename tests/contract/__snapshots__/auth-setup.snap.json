        "content-type": "application/json; charset=utf-8",
        "etag": "W/\"<express-etag-of-body>\"",
        "pragma": "no-cache",
        "vary": "Cookie, Accept-Encoding"
      },
      "security": "e30ca64edb",
      "body": {
        "json": {
          "authenticated": false,
          "configured": false,
          "enabled": true,
          "guestEnabled": false,
          "role": null,
          "setupRequired": true
