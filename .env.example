# Native Go application / Docker Compose settings.
# Copy to .env for Compose. Bare-metal launchers use exported environment values;
# they do not source this file. No Node runtime or heap settings are required.

# Host port; container listens on 3000.
TGDL_PORT=3000
TZ=Asia/Bangkok

# The existing data directory must be readable/writable by this UID/GID.
# Use `id -u` and `id -g` on the host; defaults match the image user.
TGDL_UID=1000
TGDL_GID=1000

# Forwarded headers are trusted only from the configured proxy topology.
# Empty disables trust. A trusted reverse proxy must replace client headers.
TRUST_PROXY=loopback
# Use 1 when the dashboard is served over HTTPS.
TGDL_SECURE_COOKIES=0
# Optional emergency CSP override; normally leave empty.
TGDL_CSP=
COMPRESSION_LEVEL=6

# Native process only (export before launching):
# TGDL_DATA_DIR=/path/to/data
# PORT=3000
# TGDL_SESSION_TTL_DAYS=30
# TGDL_METRICS_TOKEN=your-private-token
# FFMPEG_PATH=/usr/bin/ffmpeg
# GOMEMLIMIT=1GiB

# Synology Compose container ceiling (a soft Go heap limit alone is not a cap).
# TGDL_MEM_LIMIT=2g
