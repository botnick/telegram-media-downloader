{
    "name": "telegram-media-downloader",
    "version": "2.29.1",
    "description": "Self-hosted Telegram media downloader — CLI + Web dashboard. MIT, no quotas.",
    "type": "module",
    "main": "src/index.js",
    "bin": {
        "telegram-downloader": "src/index.js"
    },
    "files": [
        "src",
        "scripts",
        "core-service/go.mod",
        "core-service/cmd",
        "core-service/internal",
        "runner.js",
        "watchdog.ps1",
        "Dockerfile",
        "docker-compose.yml",
        "config.example.json",
        ".env.example",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "start": "node src/index.js",
        "menu": "node src/index.js menu",
        "monitor": "node src/index.js monitor",
        "history": "node src/index.js history",
        "auth": "node src/index.js auth",
        "doctor": "node src/index.js doctor",
        "prod": "node runner.js",
        "dev": "node --watch src/web/server.js",
        "migrate": "node scripts/migrate_json_to_sqlite.js",
        "recover": "node scripts/recover_groups.js",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check --write . && npm run check:oom",
        "check:oom": "sh scripts/check-oom-patterns.sh",
        "pre-download-models": "node scripts/pre-download-models.js",
        "build-indexes": "node scripts/build-indexes.js",
        "build:seekbar": "node scripts/build-seekbar.js",
        "build:core": "node scripts/build-core.js",
        "install:core": "node scripts/install-core.js",
        "postinstall": "node -e \"import('./scripts/install-core.js').catch(() => {})\"",
        "build:css": "tailwindcss -c scripts/tailwind.config.cjs -i scripts/tailwind.input.css -o src/web/public/css/tailwind.css",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:contract": "vitest run --config tests/contract/vitest.config.js",
        "test:contract:update": "node scripts/contract-run.mjs --update",
        "contract:inventory": "node scripts/contract-inventory.mjs",
        "contract:schema": "node scripts/contract-schema.mjs",
        "prepare": "lefthook install || exit 0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/botnick/telegram-media-downloader.git"
    },
    "homepage": "https://github.com/botnick/telegram-media-downloader#readme",
    "bugs": {
        "url": "https://github.com/botnick/telegram-media-downloader/issues"
    },
    "keywords": [
        "telegram",
        "downloader",
        "media-downloader",
        "telegram-stories",
        "scraper",
        "backup",
        "channel-backup",
        "gramjs",
        "self-hosted",
        "automation",
        "telegram-api"
    ],
    "author": "botnick",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1097.0",
        "@aws-sdk/lib-storage": "^3.1097.0",
        "@huggingface/transformers": "^4.3.0",
        "better-sqlite3": "^12.11.1",
        "compression": "^1.8.2",
        "express": "^4.22.2",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.3.0",
        "sharp": "^0.35.5",
        "ssh2-sftp-client": "^11.0.0",
        "telegram": "^2.19.0",
        "undici": "^7.30.0",
        "ws": "^8.21.1"
    },
    "optionalDependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "basic-ftp": "^5.0.5",
        "dropbox": "^10.38.0",
        "googleapis": "^144.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "lefthook": "^2.1.10",
        "tailwindcss": "^3.4.19",
        "vitest": "^2.1.4"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
