{
    "name": "telegram-media-downloader",
    "version": "2.32.1",
    "description": "Self-hosted Telegram media downloader — CLI + Web dashboard. MIT, no quotas.",
    "type": "module",
    "private": true,
    "files": [
        "src",
        "scripts",
        "core-service/go.mod",
        "core-service/cmd",
        "core-service/internal",
        "runner.sh",
        "watchdog.ps1",
        "Dockerfile",
        "docker-compose.yml",
        "config.example.json",
        ".env.example",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "start": "go run ./core-service/cmd/tgdl-server",
        "prod": "./runner.sh",
        "build": "go build -trimpath -o core-service/tgdl-server ./core-service/cmd/tgdl-server",
        "dev": "go run ./core-service/cmd/tgdl-server",
        "migrate": "node scripts/migrate_json_to_sqlite.js",
        "recover": "node scripts/recover_groups.js",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check --write . && npm run check:oom",
        "check:oom": "sh scripts/check-oom-patterns.sh",
        "pre-download-models": "echo 'models are managed by the configured sidecar'",
        "build-indexes": "echo 'indexes are built by tgdl-server migrations'",
        "build:seekbar": "go build -trimpath -o core-service/tgdl-server ./core-service/cmd/tgdl-server",
        "build:css": "tailwindcss -c scripts/tailwind.config.cjs -i scripts/tailwind.input.css -o src/web/public/css/tailwind.css",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:contract": "vitest run --config tests/contract/vitest.config.js",
        "test:contract:update": "node scripts/contract-run.mjs --update",
        "contract:inventory": "node scripts/contract-inventory.mjs",
        "contract:schema": "node scripts/contract-schema.mjs",
        "prepare": "lefthook install || exit 0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/botnick/telegram-media-downloader.git"
    },
    "homepage": "https://github.com/botnick/telegram-media-downloader#readme",
    "bugs": {
        "url": "https://github.com/botnick/telegram-media-downloader/issues"
    },
    "keywords": [
        "telegram",
        "downloader",
        "media-downloader",
        "telegram-stories",
        "scraper",
        "backup",
        "channel-backup",
        "gramjs",
        "self-hosted",
        "automation",
        "telegram-api"
    ],
    "author": "botnick",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1141.0",
        "@aws-sdk/lib-storage": "^3.1141.0",
        "@huggingface/transformers": "^4.3.0",
        "better-sqlite3": "^12.11.1",
        "compression": "^1.8.2",
        "express": "^4.22.3",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.3.0",
        "sharp": "^0.35.5",
        "ssh2-sftp-client": "^11.0.0",
        "telegram": "^2.19.0",
        "undici": "^7.30.0",
        "ws": "^8.22.0"
    },
    "optionalDependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "basic-ftp": "^5.0.5",
        "dropbox": "^10.47.0",
        "googleapis": "^144.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "lefthook": "^2.1.14",
        "tailwindcss": "^3.4.19",
        "vitest": "^2.1.4"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
